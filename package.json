{
  "name": "office-addin-taskpane",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Addin-TaskPane.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000,
    "lint_files": "{src,test}/**/*.ts"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "start": "office-addin-debugging start manifest.xml",
    "start:desktop": "office-addin-debugging start manifest.xml desktop",
    "start:web": "office-addin-debugging start manifest.xml web",
    "stop": "office-addin-debugging stop manifest.xml",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p . && tsc -p test",
    "validate": "office-addin-manifest validate manifest.xml",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "core-js": "^3.9.1",
    "i18next": "^21.8.1",
    "regenerator-runtime": "^0.13.7"
  },
  "devDependencies": {
    "@babel/core": "^7.13.10",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.13.0",
    "@types/jest": "^30.0.0",
    "@types/office-js": "^1.0.180",
    "@types/office-runtime": "^1.0.17",
    "acorn": "^8.5.0",
    "babel-jest": "^30.5.2",
    "babel-loader": "^8.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-office-addins": "^5.0.1",
    "globals": "^17.13.0",
    "html-loader": "^2.1.2",
    "html-webpack-plugin": "^5.3.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "office-addin-cli": "^3.0.1",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-lint": "^4.0.1",
    "office-addin-manifest": "^3.0.1",
    "office-addin-prettier-config": "^3.0.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "ie 11"
  ],
  "overrides": {
    "minimatch@3": ">=3.1.3",
    "minimatch@5": ">=5.1.8",
    "node-forge": ">=1.4.0",
    "adm-zip": "^0.6.1",
    "js-yaml@3": {
      "argparse": "^2.0.1"
    }
  }
}
